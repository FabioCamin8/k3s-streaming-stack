# Copy to a protected operator path before rendering. Never commit the copy.
REMUX_HOST=remux.example.com
REMUX_PUBLIC_HTTPS_PORT=443
# Replace the private AIOStreams user path before running configure-aiostreams.sh.
REMUX_AIOSTREAMS_MANIFEST_URL=http://aiostreams.streaming.svc.cluster.local/stremio/REPLACE_WITH_PRIVATE_USER_PATH/manifest.json
