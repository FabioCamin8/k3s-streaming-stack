# Copy to an operator-controlled file outside Git and replace every value.
# The private file is consumed by render.sh and must never be committed.
AIOSTREAMS_HOST=stream.example.com
AIOSTREAMS_PUBLIC_HTTPS_PORT=443
AIOSTREAMS_SECRET_KEY=replace-with-64-character-hex-secret
AIOSTREAMS_AUTH=admin:replace-with-a-long-password
AIOSTREAMS_TRUSTED_IPS=192.0.2.0/24
# Use the exact issuer returned by Authelia discovery, including its slash.
AIOSTREAMS_OIDC_ISSUER=https://auth.example.com/
AIOSTREAMS_OIDC_CLIENT_SECRET=replace-with-a-separate-long-client-secret
