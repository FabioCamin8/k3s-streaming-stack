# Copy this file to a protected operator location and replace every value.
# The referenced users file and secret directory are never committed.
AUTHELIA_HOST=auth.example.com
AUTHELIA_COOKIE_DOMAIN=example.com
AIOSTREAMS_HOST=stream.example.com
AIOSTREAMS_PUBLIC_HTTPS_PORT=443
REMUX_HOST=remux.example.com
AUTHELIA_USERS_DATABASE_FILE=/secure/operator-secrets/authelia/users_database.yml
AUTHELIA_SECRETS_DIR=/secure/operator-secrets/authelia/secrets
